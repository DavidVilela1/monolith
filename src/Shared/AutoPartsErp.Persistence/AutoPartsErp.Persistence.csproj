<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AutoPartsErp.Persistence</RootNamespace>
    <AssemblyName>AutoPartsErp.Persistence</AssemblyName>
    <Description>
      EF Core plumbing every module repeats: the auditing interceptor, the base context that
      turns domain events into outbox rows inside the business transaction, and the background
      processor that delivers them.
      Kept out of AutoPartsErp.Modules.Abstractions so that project stays free of EF Core -
      only a module's Infrastructure should know a database exists.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      For IHostedService and IOptions, which the outbox processor needs. The shared framework
      rather than NuGet packages, so this stays in lockstep with the runtime.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoPartsErp.SharedKernel\AutoPartsErp.SharedKernel.csproj" />
  </ItemGroup>

</Project>
