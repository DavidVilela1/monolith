<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AutoPartsErp.Persistence</RootNamespace>
    <AssemblyName>AutoPartsErp.Persistence</AssemblyName>
    <Description>
      EF Core plumbing every module repeats: the auditing interceptor and the base context
      that collects and dispatches domain events after a commit.
      Kept out of AutoPartsErp.Modules.Abstractions so that project stays free of EF Core -
      only a module's Infrastructure should know a database exists.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoPartsErp.SharedKernel\AutoPartsErp.SharedKernel.csproj" />
  </ItemGroup>

</Project>
