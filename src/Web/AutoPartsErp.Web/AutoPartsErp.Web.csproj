<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>AutoPartsErp.Web</RootNamespace>
    <AssemblyName>AutoPartsErp.Web</AssemblyName>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Description>
      The browser surface: server-rendered MVC and Razor views over the same modules the API
      serves. A library rather than a host, so the API project stays the single composition
      root — the same shape every module's Presentation project already has.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The contracts assembly, deliberately first. It is how one module asks another a question,
      and it is how this project reads stock onto a catalogue screen without either module
      knowing the other exists. A join across the two schemas would be quicker to write and
      would be the moment the modular monolith stopped being one.
    -->
    <ProjectReference Include="..\..\Shared\AutoPartsErp.ModuleContracts\AutoPartsErp.ModuleContracts.csproj" />

    <ProjectReference Include="..\..\Modules\Access\AutoPartsErp.Modules.Access.Presentation\AutoPartsErp.Modules.Access.Presentation.csproj" />
    <ProjectReference Include="..\..\Modules\Catalog\AutoPartsErp.Modules.Catalog.Presentation\AutoPartsErp.Modules.Catalog.Presentation.csproj" />
    <ProjectReference Include="..\..\Modules\Inventory\AutoPartsErp.Modules.Inventory.Presentation\AutoPartsErp.Modules.Inventory.Presentation.csproj" />
    <ProjectReference Include="..\..\Modules\Purchasing\AutoPartsErp.Modules.Purchasing.Presentation\AutoPartsErp.Modules.Purchasing.Presentation.csproj" />
  </ItemGroup>

</Project>
