@model ChangePasswordForm
@* The same form twice: once bare, when the system is insisting, and once inside the shell when
   somebody went looking for it. Only the frame around it differs, so only the frame is written
   twice. *@
<form method="post" asp-controller="Account" asp-action="ChangePassword">

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <ul class="errors" role="alert">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    }

    <div class="field">
        <label asp-for="CurrentPassword"></label>
        <input asp-for="CurrentPassword" class="input" type="password"
               autocomplete="current-password" autofocus />
        <span asp-validation-for="CurrentPassword" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" class="input" type="password"
               autocomplete="new-password" minlength="@ChangePasswordForm.MinimumLength" />
        <span asp-validation-for="NewPassword" class="field-error"></span>
        <span class="dim" style="display:block;margin-top:4px;font-size:10.5px">
            Pelo menos @ChangePasswordForm.MinimumLength caracteres.
        </span>
    </div>

    <div class="field">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" class="input" type="password"
               autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-block">Guardar</button>
</form>
