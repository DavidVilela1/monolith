@model ChangePasswordForm
@{
    bool forced = User.MustChangePassword();
    bool changed = TempData["Changed"] as bool? ?? false;

    ViewData["Title"] = "Palavra-passe";

    // Forced: no shell. The sidebar would offer screens the filter is about to bounce them off,
    // which reads as a broken system rather than as a rule. Chosen: inside the shell, because
    // they came from somewhere and want to go back there.
    Layout = forced ? "_LayoutAuth" : "_Layout";
}

@if (forced)
{
    <div class="auth">
        <div class="auth-card">
            <div class="auth-brand">
                <span class="side-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                <span class="side-name">Monolith</span>
            </div>
            <div class="auth-box">
                <div class="auth-title">Escolha uma palavra-passe</div>
                <p class="auth-note">
                    Está a usar a palavra-passe que lhe foi atribuída. Escolha outra antes de
                    continuar.
                </p>
                @await Html.PartialAsync("_ChangePasswordForm", Model)
            </div>
            <p class="auth-foot">
                Ao mudar, todas as outras sessões desta conta terminam.
            </p>
        </div>
    </div>
}
else
{
    <div class="panel" style="max-width:420px">
        <div class="panel-head">
            @Icons.Render("user", 15)
            <h2>Palavra-passe</h2>
        </div>
        <div class="panel-body">
            @if (changed)
            {
                <div class="banner" style="margin-bottom:13px" role="status">
                    @Icons.Render("check", 15)
                    <span>
                        <span class="banner-title">Alterada.</span>
                        <span class="banner-note">As outras sessões desta conta terminaram.</span>
                    </span>
                </div>
            }
            @await Html.PartialAsync("_ChangePasswordForm", Model)
        </div>
    </div>
}
