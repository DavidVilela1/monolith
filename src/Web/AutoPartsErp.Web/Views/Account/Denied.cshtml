@{
    ViewData["Title"] = "Sem permissão";
}
@* Inside the shell, not on a bare page: the person is signed in, and taking the navigation away
   from them would make a refusal look like being thrown out. *@
<div class="panel" style="max-width:520px">
    <div class="panel-head">
        @Icons.Render("hand-palm", 15)
        <h2>Sem permissão</h2>
    </div>
    <div class="panel-body">
        <p class="muted" style="margin:0">
            A sua conta não tem permissão para este ecrã. Se devia ter, fale com quem gere os
            acessos — é uma permissão que se atribui ao perfil, não à pessoa.
        </p>
    </div>
</div>
