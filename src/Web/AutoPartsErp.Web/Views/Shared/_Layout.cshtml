@using System.Globalization
@{
    string title = ViewData["Title"] as string ?? "Monolith";
    string? context = ViewData["Context"] as string;
    bool flush = ViewData["Flush"] as bool? ?? false;
    string? current = ViewContext.RouteData.Values["controller"] as string;

    // TERÇA · 18/09/2026, the way the mockup's header reads it. Portuguese, upper case, and
    // through the request culture rather than the machine's: a server in another timezone
    // should still say what day it is here.
    DateTime now = DateTime.Now;
    string today = string.Concat(
        now.ToString("dddd", CultureInfo.CurrentCulture).ToUpper(CultureInfo.CurrentCulture),
        " · ",
        now.ToString("dd/MM/yyyy", CultureInfo.CurrentCulture));
}
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>@title · Monolith</title>
    @* Preloaded because it is the one font the first paint needs; the mono face is
       wanted a few milliseconds later, for the numbers. *@
    <link rel="preload" href="~/_content/AutoPartsErp.Web/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/_content/AutoPartsErp.Web/css/monolith.css" asp-append-version="true" />
</head>
<body>
<div class="shell">

    <aside class="side">
        <div class="side-head">
            <a class="side-brand" asp-controller="Home" asp-action="Index">
                <span class="side-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                <span class="side-name">Monolith</span>
            </a>
            <span class="side-ver" title="Versão">0.1</span>
        </div>

        <nav class="side-nav" aria-label="Secções">
            @foreach (NavGroup group in Navigation.Groups)
            {
                @* A group whose every entry is hidden by permission should take its heading
                   with it, rather than leaving a title over nothing. *@
                List<NavItem> visible = group.Items
                    .Where(item => item.Permission is null || User.Can(item.Permission))
                    .ToList();

                if (visible.Count == 0)
                {
                    continue;
                }

                <div class="side-group label">@group.Title</div>

                foreach (NavItem item in visible)
                {
                    if (item.IsBuilt)
                    {
                        <a class="nav-item"
                           asp-controller="@item.Controller" asp-action="Index"
                           aria-current="@(string.Equals(item.Controller, current, StringComparison.Ordinal) ? "page" : null)">
                            @Icons.Render(item.Icon, 15)
                            <span>@item.Label</span>
                        </a>
                    }
                    else
                    {
                        <span class="nav-item is-pending" title="Ainda não construído">
                            @Icons.Render(item.Icon, 15)
                            <span>@item.Label</span>
                        </span>
                    }
                }
            }
        </nav>

        <div class="side-foot">
            @* Not a selector yet. The warehouse a person is working in comes from Inventory,
               which this project does not reference, and a picker that cannot pick is worse
               than none. *@
            <span class="place">
                @Icons.Render("warehouse", 15)
                <span class="truncate">
                    <span class="place-name">Armazém</span>
                    <span class="place-note">por configurar</span>
                </span>
            </span>
        </div>
    </aside>

    <div class="main">
        <header class="top">
            <div class="top-title">
                <h1>@title</h1>
                <span class="top-ctx">@(context ?? today)</span>
            </div>

            <div class="top-tools">
                @await RenderSectionAsync("Tools", required: false)

                <span class="avatar" title="@User.DisplayName()">@User.Initials()</span>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-sq" title="Sair" aria-label="Sair">
                        @Icons.Render("sign-out", 14)
                    </button>
                </form>
            </div>
        </header>

        <main class="page @(flush ? "page-tight" : null)">
            @RenderBody()
        </main>
    </div>

</div>
</body>
</html>
