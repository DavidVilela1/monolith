@model PartDetail
@using System.Globalization
@{
    ViewData["Title"] = Model.Sku;
    ViewData["Context"] = Model.BrandCode.ToUpperInvariant();
    ViewData["Flush"] = true;
    CultureInfo pt = CultureInfo.CurrentCulture;
}

@section Tools {
    <a class="btn" asp-action="Index">@Icons.Render("arrow-left", 14) Peças</a>
}

<div class="strip">
    <div class="strip-fact" style="flex:2">
        <div class="label">Designação</div>
        <div class="value">@Model.Name</div>
        <div class="note">
            <span class="tag @PartStatusText.Tone(Model.Status)">@PartStatusText.Of(Model.Status)</span>
        </div>
    </div>
    <div class="strip-fact">
        <div class="label">Nº fabricante</div>
        <div class="value mono">@Model.ManufacturerPartNumber</div>
        <div class="note mono">@Model.NormalizedPartNumber</div>
    </div>
    <div class="strip-fact">
        <div class="label">Marca</div>
        <div class="value">@Model.BrandName</div>
        <div class="note mono">@Model.BrandCode</div>
    </div>
    <div class="strip-fact">
        <div class="label">Família</div>
        <div class="value">@Model.CategoryName</div>
        <div class="note">unidade @Model.StockUnit</div>
    </div>
</div>

@if (Model.IsDangerousGoods || Model.SupersededByPartId is not null)
{
    <div style="padding:11px 18px 0;display:flex;flex-direction:column;gap:8px">
        @if (Model.SupersededByPartId is Guid replacement)
        {
            <div class="banner banner-wn">
                @Icons.Render("arrow-u-up-left", 15)
                <span>
                    <span class="banner-title">Substituída.</span>
                    <span class="banner-note">Esta peça saiu de linha e tem sucessora.</span>
                </span>
                <a class="right btn-link" asp-action="Details" asp-route-id="@replacement">
                    Abrir a peça que a substitui
                </a>
            </div>
        }

        @if (Model.IsDangerousGoods)
        {
            <div class="banner banner-dg">
                @Icons.Render("warning", 15)
                <span>
                    <span class="banner-title">Mercadoria perigosa.</span>
                    <span class="banner-note">
                        Aplicam-se regras de embalagem e transporte@(string.IsNullOrWhiteSpace(Model.UnNumber) ? "." : $" — UN {Model.UnNumber}.")
                    </span>
                </span>
            </div>
        }
    </div>
}

<div class="panels" style="flex:1;min-height:0;overflow:auto;padding:12px 18px;align-content:start">

    <section class="panel">
        <div class="panel-head">
            @Icons.Render("nut", 15)
            <h2>Ficha</h2>
        </div>
        <div class="panel-body">
            <dl class="facts">
                <dt>Referência</dt><dd class="mono">@Model.Sku</dd>
                <dt>Peso</dt><dd class="num">@Model.WeightKg.ToString("N3", pt) kg</dd>

                @if (Model.LengthMm is not null || Model.WidthMm is not null || Model.HeightMm is not null)
                {
                    <dt>Dimensões</dt>
                    <dd class="num">
                        @Dim(Model.LengthMm) × @Dim(Model.WidthMm) × @Dim(Model.HeightMm) mm
                    </dd>
                }

                @if (Model.RequiresCoreReturn)
                {
                    <dt>Depósito de troca</dt>
                    <dd class="num">
                        @(Model.CoreChargeAmount?.ToString("N2", pt) ?? "—") @Model.CoreChargeCurrency
                    </dd>
                }
            </dl>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="muted" style="margin:13px 0 0;font-size:11.5px">@Model.Description</p>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            @Icons.Render("arrows-clockwise", 15)
            <h2>Equivalências</h2>
            <span class="panel-note">@Model.CrossReferences.Count</span>
        </div>
        <div class="panel-body panel-body-flush">
            @if (Model.CrossReferences.Count == 0)
            {
                <div class="empty">
                    @Icons.Render("arrows-clockwise", 24)
                    <strong>Nenhuma equivalência</strong>
                    <span>Sem outros números que cheguem a esta peça.</span>
                </div>
            }
            else
            {
                <table class="grid grid-pad">
                    <thead>
                        <tr>
                            <th scope="col">Número</th>
                            <th scope="col">Marca</th>
                            <th scope="col">Tipo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (CrossReferenceDto reference in Model.CrossReferences)
                        {
                            <tr>
                                <td class="cell-id">@reference.Number</td>
                                <td class="muted">@(reference.SourceBrand ?? "—")</td>
                                <td class="dim">@reference.Kind</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>

    <section class="panel" style="grid-column:1/-1">
        <div class="panel-head">
            @Icons.Render("truck", 15)
            <h2>Aplicações</h2>
            <span class="panel-note">@Model.Fitments.Count</span>
        </div>
        <div class="panel-body panel-body-flush">
            @if (Model.Fitments.Count == 0)
            {
                <div class="empty">
                    @Icons.Render("truck", 24)
                    <strong>Nenhuma aplicação</strong>
                    <span>Esta peça ainda não está ligada a nenhum veículo.</span>
                </div>
            }
            else
            {
                <table class="grid grid-pad">
                    <thead>
                        <tr>
                            <th scope="col">Marca</th>
                            <th scope="col">Modelo</th>
                            <th scope="col">Motor</th>
                            <th scope="col" class="num">De</th>
                            <th scope="col" class="num">Até</th>
                            <th scope="col">Posição</th>
                            <th scope="col">Nota</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (FitmentDto fitment in Model.Fitments)
                        {
                            <tr>
                                <td>@fitment.Make</td>
                                <td>@fitment.Model</td>
                                <td class="mono dim">@(fitment.EngineCode ?? "—")</td>
                                <td class="num">@fitment.YearFrom.ToString(CultureInfo.InvariantCulture)</td>
                                <td class="num">@fitment.YearTo.ToString(CultureInfo.InvariantCulture)</td>
                                <td class="muted">@(fitment.Position ?? "—")</td>
                                <td class="dim truncate">@(fitment.Notes ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>

</div>

@functions {
    private static string Dim(decimal? millimetres) =>
        millimetres?.ToString("N0", CultureInfo.CurrentCulture) ?? "—";
}
