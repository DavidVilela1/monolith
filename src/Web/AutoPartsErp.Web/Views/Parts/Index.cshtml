@model PartSearchResults
@using System.Globalization
@using AutoPartsErp.ModuleContracts.Inventory
@using AutoPartsErp.Modules.Inventory.Application.Contracts
@{
    ViewData["Title"] = "Peças";
    ViewData["Flush"] = true;

    PagedResult<PartSummary> results = Model.Page;
    PartSearchForm search = Model.Search;
    WarehouseDto? place = Model.Warehouse;
    CultureInfo pt = CultureInfo.CurrentCulture;

    ViewData["Context"] = $"CATÁLOGO · {results.TotalCount.ToString("N0", pt)} REFERÊNCIAS";
    ViewData["WarehouseCode"] = place?.Code;
    ViewData["WarehouseName"] = place?.Name;

    int first = results.TotalCount == 0 ? 0 : ((results.Page - 1) * results.PageSize) + 1;
    int last = Math.Min(results.Page * results.PageSize, results.TotalCount);

    // What the pager has to carry with it. A "next page" link that dropped the filters would
    // silently show page two of a different search, which is the kind of bug somebody trusts.
    var filters = new Dictionary<string, string>(StringComparer.Ordinal);

    if (!string.IsNullOrWhiteSpace(search.Term))
    {
        filters["term"] = search.Term;
    }

    if (!string.IsNullOrWhiteSpace(search.Status))
    {
        filters["status"] = search.Status;
    }

    if (search.BrandId is Guid brandId)
    {
        filters["brandId"] = brandId.ToString();
    }

    if (search.CategoryId is Guid categoryId)
    {
        filters["categoryId"] = categoryId.ToString();
    }

    if (search.WarehouseId is Guid warehouseId)
    {
        filters["warehouseId"] = warehouseId.ToString();
    }
}

@section Tools {
    <a class="btn" asp-action="Index" asp-all-route-data="filters">
        @Icons.Render("arrows-clockwise", 14) Atualizar
    </a>
}

<form method="get" asp-action="Index">
    <input type="hidden" name="page" value="1" />

    <div class="chips" style="padding:11px 18px;border-bottom:1px solid var(--ln);background:var(--sf)">

        <label class="search" style="width:196px">
            @Icons.Render("magnifying-glass", 13)
            <input type="search" name="term" value="@search.Term" autofocus spellcheck="false"
                   placeholder="Referência, nº do fabricante, equivalência ou nome"
                   aria-label="Procurar peça" />
        </label>

        @if (Model.Warehouses.Count > 0)
        {
            <span class="chip">
                @Icons.Render("warehouse", 13)
                Armazém
                <span class="select-wrap" style="width:70px">
                    <select name="warehouseId" class="select"
                            style="height:22px;border:0;background:none;padding:0 18px 0 0"
                            aria-label="Armazém">
                        @foreach (WarehouseDto warehouse in Model.Warehouses)
                        {
                            <option value="@warehouse.Id" selected="@(search.WarehouseId == warehouse.Id)">
                                @warehouse.Code
                            </option>
                        }
                    </select>
                    @Icons.Render("caret-down", 12)
                </span>
            </span>
        }

        <span class="chip">
            @Icons.Render("tag", 13)
            Marca
            <span class="select-wrap" style="width:92px">
                <select name="brandId" class="select"
                        style="height:22px;border:0;background:none;padding:0 18px 0 0"
                        aria-label="Marca">
                    <option value="">todas</option>
                    @foreach (BrandDto brand in Model.Brands)
                    {
                        <option value="@brand.Id" selected="@(search.BrandId == brand.Id)">@brand.Name</option>
                    }
                </select>
                @Icons.Render("caret-down", 12)
            </span>
        </span>

        <span class="chip">
            @Icons.Render("stack", 13)
            Família
            <span class="select-wrap" style="width:92px">
                <select name="categoryId" class="select"
                        style="height:22px;border:0;background:none;padding:0 18px 0 0"
                        aria-label="Família">
                    <option value="">todas</option>
                    @foreach (CategoryDto category in Model.Categories)
                    {
                        <option value="@category.Id" selected="@(search.CategoryId == category.Id)">@category.Name</option>
                    }
                </select>
                @Icons.Render("caret-down", 12)
            </span>
        </span>

        <span class="chip">
            @Icons.Render("funnel", 13)
            Estado
            <span class="select-wrap" style="width:82px">
                <select name="status" class="select"
                        style="height:22px;border:0;background:none;padding:0 18px 0 0"
                        aria-label="Estado">
                    <option value="">todos</option>
                    @foreach (string status in new[] { "Active", "Draft", "Discontinued", "Obsolete" })
                    {
                        <option value="@status" selected="@(search.Status == status)">@PartStatusText.Of(status)</option>
                    }
                </select>
                @Icons.Render("caret-down", 12)
            </span>
        </span>

        <button type="submit" class="btn btn-primary">Procurar</button>

        @if (search.IsFiltered)
        {
            <a class="chip chip-on" asp-action="Index"
               asp-route-warehouseId="@search.WarehouseId" title="Limpar os filtros">
                @Icons.Render("x", 12) Limpar
            </a>
        }

        <span class="mono dim" style="margin-left:auto;font-size:10.5px">
            @results.TotalCount.ToString("N0", pt) resultados
        </span>
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div style="padding:11px 18px">
        <div class="banner banner-dg" role="alert">
            @Icons.Render("warning", 15)
            <span>@ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage</span>
        </div>
    </div>
}

@if (Model.Warehouses.Count == 0)
{
    @* Not a silent absence. Without a warehouse there is no such thing as "how many", and three
       empty columns with no explanation is how somebody concludes the stock is zero. *@
    <div style="padding:11px 18px 0">
        <div class="banner banner-wn">
            @Icons.Render("warehouse", 15)
            <span>
                <span class="banner-title">Sem armazéns.</span>
                <span class="banner-note">
                    Enquanto não existir um armazém não há stock para mostrar — só o catálogo.
                </span>
            </span>
        </div>
    </div>
}

@if (Model.Rows.Count == 0)
{
    <div class="empty" style="flex:1">
        @Icons.Render("list-magnifying-glass", 28)
        <strong>Nada encontrado</strong>
        @if (!string.IsNullOrWhiteSpace(search.Term))
        {
            <span>Os números casam pelo princípio, não pelo meio — experimente menos caracteres.</span>
        }
        else
        {
            <span>Nenhuma peça corresponde a estes filtros.</span>
        }
    </div>
}
else
{
    <div class="grid-wrap">
        <table class="grid grid-pad">
            <thead>
                <tr>
                    <th scope="col">SKU</th>
                    <th scope="col">Designação</th>
                    <th scope="col">Nº fabricante</th>
                    <th scope="col">Marca</th>
                    <th scope="col">Família</th>
                    @if (place is not null)
                    {
                        <th scope="col" class="num" title="Fisicamente no armazém @place.Code">Stock</th>
                        <th scope="col" class="num" title="Já prometido a alguém">Reserv.</th>
                        <th scope="col" class="num" title="Stock menos reservado">Disp.</th>
                    }
                    <th scope="col">Un.</th>
                    <th scope="col">Troca</th>
                    <th scope="col">Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (PartRow row in Model.Rows)
                {
                    PartSummary part = row.Part;
                    StockAvailability? stock = row.Stock;

                    <tr>
                        <td class="cell-id">
                            <a asp-action="Details" asp-route-id="@part.Id">@part.Sku</a>
                        </td>
                        <td class="truncate" style="max-width:1px;width:34%">@part.Name</td>
                        <td class="mono dim" style="font-size:11px">@part.ManufacturerPartNumber</td>
                        <td class="muted truncate">@part.BrandName</td>
                        <td class="muted truncate">@part.CategoryName</td>

                        @if (place is not null)
                        {
                            @* A part Inventory has never heard of shows a dash, never a zero.
                               Zero means "none left"; a dash means "nobody has counted". Those
                               are different answers and only one of them stops a sale. *@
                            <td class="num">@Qty(stock?.OnHand)</td>
                            <td class="num muted">@Qty(stock?.Reserved)</td>
                            <td class="num @Tone(stock)">@Qty(stock?.Available)</td>
                        }

                        <td class="mono dim" style="font-size:10.5px">@part.StockUnit</td>
                        <td>
                            @if (part.RequiresCoreReturn)
                            {
                                <span class="tag tag-wn">troca</span>
                            }
                            else
                            {
                                <span class="dim">—</span>
                            }
                        </td>
                        <td><span class="tag @PartStatusText.Tone(part.Status)">@PartStatusText.Of(part.Status)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="panel-foot" style="padding:0 18px">
        <span class="mono dim" style="font-size:10.5px">
            @first.ToString("N0", pt)–@last.ToString("N0", pt) de @results.TotalCount.ToString("N0", pt)
        </span>

        @if (place is not null)
        {
            <span class="dim" style="font-size:10.5px">
                stock em <span class="mono">@place.Code</span> · @place.Name
            </span>
        }

        <div class="pager" style="margin-left:auto">
            <a class="btn btn-sq" aria-label="Página anterior"
               aria-disabled="@(results.Page <= 1 ? "true" : null)"
               asp-action="Index" asp-all-route-data="filters"
               asp-route-page="@(results.Page - 1)">@Icons.Render("caret-left", 12)</a>

            <span class="mono dim" style="font-size:10.5px;padding:0 4px">
                @results.Page / @Math.Max(results.TotalPages, 1)
            </span>

            <a class="btn btn-sq" aria-label="Página seguinte"
               aria-disabled="@(results.Page >= results.TotalPages ? "true" : null)"
               asp-action="Index" asp-all-route-data="filters"
               asp-route-page="@(results.Page + 1)">@Icons.Render("caret-right", 12)</a>
        </div>
    </div>
}

@functions {
    /// <summary>A quantity, or a dash when nobody has counted.</summary>
    private static string Qty(decimal? quantity) =>
        quantity?.ToString("N0", CultureInfo.CurrentCulture) ?? "—";

    /// <summary>
    /// Red when there is nothing left to promise, amber when the shelf is empty but something is
    /// still reserved off it, and nothing at all otherwise. A screen that colours every row stops
    /// being read.
    /// </summary>
    private static string Tone(StockAvailability? stock) => stock switch
    {
        null => "dim",
        { Available: <= 0m } => "bad",
        { OnHand: <= 0m } => "warn",
        _ => string.Empty,
    };
}
