<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AutoPartsErp.Modules.Pricing.Infrastructure</RootNamespace>
    <AssemblyName>AutoPartsErp.Modules.Pricing.Infrastructure</AssemblyName>
    <Description>
      The Pricing module's persistence: its own PostgreSQL schema, EF Core mappings,
      repositories, read store and the candidate query the resolver runs on.
      This is the only project in the module that knows a database exists.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoPartsErp.Modules.Pricing.Application\AutoPartsErp.Modules.Pricing.Application.csproj" />
    <ProjectReference Include="..\..\..\Shared\AutoPartsErp.Modules.Abstractions\AutoPartsErp.Modules.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Shared\AutoPartsErp.Persistence\AutoPartsErp.Persistence.csproj" />
  </ItemGroup>

</Project>
