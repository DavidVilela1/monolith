<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AutoPartsErp.Modules.Invoicing.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Invoicing\AutoPartsErp.Modules.Invoicing.Domain\AutoPartsErp.Modules.Invoicing.Domain.csproj" />

    <!--
      Added for the SAF-T writer tests. The writer is a pure function that lives in Application
      because that is where the shape of the file is decided, and it is the part of the export
      most worth testing exhaustively - so the test project has to be able to see it.
    -->
    <ProjectReference Include="..\..\src\Modules\Invoicing\AutoPartsErp.Modules.Invoicing.Application\AutoPartsErp.Modules.Invoicing.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
